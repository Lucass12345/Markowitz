# Copy to .env.production, chmod 600, replace every value. Never commit real secrets.
POSTGRES_DB=markowitz
POSTGRES_USER=markowitz_app
POSTGRES_PASSWORD=REPLACE_WITH_RANDOM_SECRET
DATABASE_URL=postgresql+psycopg2://markowitz_app:URL_ENCODED_PASSWORD@postgres:5432/markowitz
MINIO_ROOT_USER=REPLACE_WITH_ADMIN_USER
MINIO_ROOT_PASSWORD=REPLACE_WITH_RANDOM_ADMIN_SECRET
MINIO_ACCESS_KEY=REPLACE_WITH_SERVICE_KEY
MINIO_SECRET_KEY=REPLACE_WITH_RANDOM_SECRET
MARKOWITZ_API_KEY=REPLACE_WITH_64_HEX_CHARACTERS_FROM_SECRETS_TOKEN_HEX
MARKOWITZ_READ_API_KEY=
CORS_ALLOWED_ORIGINS=https://portfolio.example.com
CODE_VERSION=REPLACE_WITH_GIT_COMMIT
API_IMAGE=markowitz-api:REPLACE_WITH_GIT_COMMIT
STREAMLIT_IMAGE=markowitz-ui:REPLACE_WITH_GIT_COMMIT
MLFLOW_IMAGE=markowitz-mlflow:2.21.0
DATA_VOLUME_PATH=/srv/markowitz/Data
