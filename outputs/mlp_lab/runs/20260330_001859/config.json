{
  "start_date": "2022-01-01",
  "forecast_horizon": 1,
  "target_aggregation": "mean",
  "lags": 20,
  "short_window": 5,
  "long_window": 20,
  "hidden_layers": [
    64,
    32
  ],
  "activation": "relu",
  "solver": "adam",
  "scaler": "standard",
  "alpha": 0.0001,
  "learning_rate": "adaptive",
  "learning_rate_init": 0.0005,
  "max_iter": 500,
  "batch_size": "auto",
  "early_stopping": false,
  "validation_fraction": 0.15,
  "n_iter_no_change": 20,
  "clip_pred": 0.005,
  "winsorize_quantile": 0.01,
  "include_abs_features": true,
  "include_square_features": false,
  "include_sign_features": true,
  "selection_policy": {
    "policy_type": "all_assets"
  }
}